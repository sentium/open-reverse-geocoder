{
  "name": "@geolonia/open-reverse-geocoder",
  "version": "0.0.7",
  "description": "",
  "main": "./dist/main.js",
  "scripts": {
    "test": "jest --runInBand",
    "lint": "eslint \"src/**/*.ts\"",
    "build": "rm -rf ./dist && rollup -c ./rollup.config.mjs",
    "build:tiles": "bash bin/build.sh",
    "typecheck": "tsc --noEmit",
    "build:data": "node bin/build-search-data.js",
    "validate:data": "node bin/validate-search-data.js",
    "test:data": "node --test test/search-data.test.js test/data-artifacts.test.js",
    "test:integration": "node --test test/integration.test.js",
    "test:package": "node --test test/package.test.js",
    "test:osm": "python3 test/osm-data.test.py && node --test test/osm-integration.test.js test/osm-regions.test.js",
    "validate:osm": "node bin/validate-osm-data.js"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/d3-geo": "^2.0.0",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.1",
    "@types/pbf": "^3.0.2",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "jest": "30.5.1",
    "prettier": "3.9.6",
    "rollup": "4.63.1",
    "ts-jest": "29.4.12",
    "tslib": "2.8.1",
    "typescript": "5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "ts",
      "js"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "testEnvironment": "node",
    "testMatch": [
      "**/src/**/*.test.ts"
    ],
    "roots": [
      "<rootDir>/src"
    ]
  },
  "dependencies": {
    "@mapbox/vector-tile": "^1.3.1",
    "d3-geo": "2.0.2",
    "fflate": "^0.8.3",
    "global-mercator": "^3.1.0",
    "pbf": "3.2.1"
  },
  "types": "dist/main.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.6.1"
}
